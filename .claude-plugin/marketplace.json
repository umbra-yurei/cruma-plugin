{
  "name": "cruma-plugin",
  "description": "Claude Code plugin marketplace for the Cruma tunnel agent.",
  "owner": {
    "name": "Cruma"
  },
  "plugins": [
    {
      "name": "cruma",
      "source": "./",
      "description": "Install the Cruma tunnel agent, publish a dev server or a folder (several sites at once) and drive it over MCP.",
      "homepage": "https://cruma.io",
      "repository": "https://github.com/umbra-yurei/cruma-plugin",
      "relevance": {
        "topic": "tunnels",
        "signals": {
          "cli": [
            "ngrok",
            "cloudflared",
            "localtunnel",
            "lt",
            "cruma"
          ],
          "manifestDeps": [
            {
              "file": "[/\\\\]package\\.json$",
              "pattern": "\"(vite|next|@sveltejs/kit|webpack-dev-server)\"\\s*:"
            }
          ]
        }
      }
    }
  ]
}
